# Postgres
DATABASE_URL=postgresql://tecnovo:tecnovo@localhost:5434/tecnovo?schema=public
# Sin pooler. Lo usa `prisma migrate`, nunca la app.
DIRECT_URL=postgresql://tecnovo:tecnovo@localhost:5434/tecnovo?schema=public

# Dónde viven las imágenes subidas.
#   disk     -> public/uploads (local y VPS con Docker)
#   supabase -> bucket de Supabase Storage (Vercel, filesystem de solo lectura)
STORAGE_DRIVER=disk
# Requeridos solo con STORAGE_DRIVER=supabase.
# NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Auth.js (F7)
AUTH_SECRET=cambia-esto-en-local
AUTH_URL=http://localhost:3000

# Sitio / WhatsApp
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP=573122779324

# Wompi (F6). Sandbox y producción usan llaves distintas.
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=pub_test_XXXX
WOMPI_INTEGRITY_SECRET=prod_integrity_XXXX
WOMPI_EVENTS_SECRET=stg_XXXX
# WOMPI_DIST_PUBLIC_KEY=
# WOMPI_DIST_INTEGRITY_SECRET=
# WOMPI_DIST_EVENTS_SECRET=

# Seed del usuario administrador (lo crea `npm run db:seed`).
# ADMIN_EMAIL=jefe@tecnovo.com
# ADMIN_PASSWORD=