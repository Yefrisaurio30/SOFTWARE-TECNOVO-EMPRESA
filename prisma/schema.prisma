generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  MAYORISTA
  DISTRIBUIDOR
  CLIENTE
}

enum ProductType {
  MOTO_NUEVA
  MOTO_USADA
  REPUESTO
  ACCESORIO
}

enum OrderStatus {
  PENDIENTE
  PAGADO
  RECHAZADO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum DistributorStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model User {
  id            String               @id @default(cuid())
  name          String?
  email         String               @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role                 @default(CLIENTE)
  distributor   DistributorProfile?
  orders        Order[]
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id             String      @id @default(cuid())
  slug           String      @unique
  name           String
  type           ProductType
  brand          String
  priceRetail    Int
  priceWholesale Int?
  stock          Int         @default(0)
  description    String      @default("")
  images         String[]    @default([])
  specs          Json        @default("{}")
  featured       Boolean     @default(false)
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orderItems     OrderItem[]

  @@index([type, active, featured])
  @@index([brand])
}

model Order {
  id           String      @id @default(cuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  status       OrderStatus @default(PENDIENTE)
  total        Int
  isWholesale  Boolean     @default(false)
  paymentRef   String?     @unique
  contactName  String      @default("")
  contactPhone String      @default("")
  contactEmail String?
  city         String      @default("")
  address      String      @default("")
  delivery     String      @default("ENVIO")
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Int
  unitPrice Int
}

model DistributorProfile {
  id        String            @id @default(cuid())
  userId    String            @unique
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   String
  nit       String            @unique
  city      String
  phone     String
  status    DistributorStatus @default(PENDIENTE)
  minUnits  Int               @default(1)
  createdAt DateTime          @default(now())
}

model SiteSetting {
  key   String @id
  value Json
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())
}
