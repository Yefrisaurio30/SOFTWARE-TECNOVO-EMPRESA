generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  MAYORISTA
  DISTRIBUIDOR
  CLIENTE
}

enum ProductType {
  MOTO_NUEVA
  MOTO_USADA
  REPUESTO
  ACCESORIO
}

enum OrderStatus {
  PENDIENTE
  PAGADO
  RECHAZADO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum DistributorStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
}

/// Estado de moderación de una publicación.
/// DRAFT: el usuario está completando el formulario (no es un anuncio aún).
enum ListingStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String               @id @default(cuid())
  name          String?
  email         String               @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role                 @default(CLIENTE)
  distributor   DistributorProfile?
  orders        Order[]
  listings      Product[]
  consents      Consent[]
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  type           ProductType
  brand          String
  priceRetail    Int
  priceWholesale Int?
  stock          Int           @default(0)
  description    String        @default("")
  images         String[]      @default([])
  specs          Json          @default("{}")
  featured       Boolean       @default(false)
  active         Boolean       @default(true)
  /// Moderación. Default APPROVED: el inventario de la tienda nace visible.
  status         ListingStatus @default(APPROVED)
  /// Quien publicó el anuncio. null = inventario de TECNOVO.
  ownerId        String?
  owner          User?         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Motivo por el que el admin rechazó el anuncio.
  reviewNote     String?
  /// El dueño marcó la moto como vendida. Se sale del catálogo al instante.
  soldAt         DateTime?
  /// Borrador que se elimina pasado este tiempo si el usuario no lo termina.
  draftExpiresAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  orderItems     OrderItem[]

  @@index([type, active, featured])
  @@index([brand])
  @@index([type, status, active])
  @@index([status, draftExpiresAt])
  @@index([ownerId])
}

model Order {
  id           String      @id @default(cuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  status       OrderStatus @default(PENDIENTE)
  total        Int
  isWholesale  Boolean     @default(false)
  paymentRef   String?     @unique
  contactName  String      @default("")
  contactPhone String      @default("")
  contactEmail String?
  city         String      @default("")
  address      String      @default("")
  delivery     String      @default("ENVIO")
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Int
  unitPrice Int
}

model DistributorProfile {
  id        String            @id @default(cuid())
  userId    String            @unique
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   String
  nit       String            @unique
  city      String
  phone     String
  status    DistributorStatus @default(PENDIENTE)
  minUnits  Int               @default(1)
  createdAt DateTime          @default(now())
}

/// Cursos y guías de capacitación (/capacitacion). Los carga el jefe desde el admin.
model Course {
  id           String    @id @default(cuid())
  title        String
  summary      String    @default("")
  youtubeUrl   String?
  startsAt     DateTime?
  modality     String?
  city         String?
  price        Int?
  order        Int       @default(0)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([active, order])
}

model SiteSetting {
  key   String @id
  value Json
}

/// Prueba de consentimiento para atender requerimientos de la SIC.
/// Se guarda en el mismo momento en que la persona marca las casillas.
model Consent {
  id String @id @default(cuid())
  /// El usuario puede no existir aún si el consentimiento se da antes del registro.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  email  String
  /// REGISTRO | PUBLICACION
  source String

  termsAccepted   Boolean   @default(false)
  termsAcceptedAt DateTime?
  privacyAccepted   Boolean   @default(false)
  privacyAcceptedAt DateTime?

  ipAddress String  @default("")
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([source])
  @@index([email])
}

/// Red de servicio y soporte técnico (/taller).
model Service {
  id        String   @id @default(cuid())
  name      String
  city      String
  address   String   @default("")
  phone     String   @default("")
  mapsUrl   String?
  services  String[] @default([])
  warranty  Boolean  @default(true)
  isHeadquarter Boolean @default(false)
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())
}
